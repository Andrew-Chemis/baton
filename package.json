{
  "name": "baton-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --max-warnings=0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:strings": "node scripts/check-strings.ts",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "vitest run --project service --project web --project cli --project cdk-synth --project scripts",
    "test:pack": "vitest run --project pack",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "ddb:local": "node scripts/dynamodb-local.ts",
    "dev": "node scripts/dev-server.ts",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright-core": "1.65.0",
    "semantic-release": "^25.0.9",
    "semantic-release-unsquash": "^0.4.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
