{
  "name": "@andrewchemis/baton-cdk",
  "version": "0.0.0",
  "description": "AWS CDK constructs that deploy Baton, an agent-first kanban board: DynamoDB, API Gateway, Cognito, S3 and CloudFront",
  "keywords": [
    "baton",
    "kanban",
    "agents",
    "aws-cdk",
    "cdk",
    "dynamodb"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andrew-Chemis/baton.git",
    "directory": "packages/cdk"
  },
  "homepage": "https://github.com/Andrew-Chemis/baton#readme",
  "bugs": "https://github.com/Andrew-Chemis/baton/issues",
  "author": {
    "name": "Andrew Chemis"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "assets/api/index.js",
    "assets/web"
  ],
  "scripts": {
    "build:assets": "node scripts/build-assets.mts",
    "build:lib": "tsc -p tsconfig.build.json",
    "build": "rm -rf lib assets/api assets/web && node scripts/build-assets.mts && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "preact": "^11.2.0",
    "vite": "^8.3.6"
  }
}
