{
  "name": "@andrewchemis/baton-cli",
  "version": "0.1.1",
  "description": "The baton command: claim, heartbeat, check and pass cards on a Baton board from any git checkout",
  "keywords": [
    "baton",
    "kanban",
    "agents",
    "cli",
    "claude-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andrew-Chemis/baton.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Andrew-Chemis/baton#readme",
  "bugs": "https://github.com/Andrew-Chemis/baton/issues",
  "author": {
    "name": "Andrew Chemis"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "baton": "./dist/baton.mjs"
  },
  "files": [
    "dist/baton.mjs"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/build.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5",
    "esbuild": "^0.28.2"
  }
}
